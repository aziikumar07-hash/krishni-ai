# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.

# ── Public site URL ───────────────────────────────────────────────
# Used for canonical tags and absolute og:image URLs. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://krishniai.online

# ── Google Gemini ─────────────────────────────────────────────────
# aistudio.google.com → Get API key. Powers /api/chat and /api/diagnose.
GEMINI_API_KEY=

# Model id. gemini-flash-latest tracks the current fast model.
GEMINI_MODEL=gemini-flash-latest

# ── WhatsApp Cloud API ────────────────────────────────────────────
# developers.facebook.com → your app → WhatsApp → API Setup
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
# Any random string you invent; paste the same value into the Meta webhook UI.
VERIFY_TOKEN=
# App Dashboard → Settings → Basic → App Secret. Verifies X-Hub-Signature-256.
WHATSAPP_APP_SECRET=

# ── Lead capture ──────────────────────────────────────────────────
# Existing Formspree endpoint id from the legacy page.
FORMSPREE_FORM_ID=maqzyrvy
